# ML Backend configuration

# spaCy model: ru_core_news_sm (faster) or ru_core_news_lg (more accurate)
SPACY_MODEL=ru_core_news_sm

# Model storage paths (Windows paths, adjust as needed)
MODELS_DIR=C:\NER-app\models
LOGS_DIR=C:\NER-app\logs

# Training hyperparameters
TRAINING_ITERATIONS=30
TRAINING_DROPOUT=0.3

# WebAPI integration (leave empty to disable)
WEBAPI_BASE_URL=
WEBAPI_TOKEN=
WEBAPI_TIMEOUT=10
WEBAPI_MAX_RETRIES=3
WEBAPI_RETRY_DELAY=1.0

# LLM integration (LM Studio / llama.cpp)
LLM_ENABLED=false
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY=1.0

# Server settings
ML_BACKEND_HOST=0.0.0.0
ML_BACKEND_PORT=9090
FLASK_DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Label Studio connection (for fetching annotations)
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_KEY=
