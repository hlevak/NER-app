# Label Studio configuration

# Database connection (PostgreSQL)
DJANGO_DB=default
POSTGRE_NAME=label_studio
POSTGRE_USER=label_studio_user
POSTGRE_PASSWORD=LabelStudio2024!
POSTGRE_PORT=5432
POSTGRE_HOST=localhost

# Label Studio settings
LABEL_STUDIO_HOST=http://localhost:8080
LABEL_STUDIO_PORT=8080

# Disable telemetry for offline use
COLLECT_ANALYTICS=false

# Storage
LABEL_STUDIO_LOCAL_FILES_SERVING_ENABLED=true
LABEL_STUDIO_LOCAL_FILES_DOCUMENT_ROOT=C:\NER-app\data

# Security
SECRET_KEY=change-this-secret-key-in-production-ner-app-2024

# ML Backend URL
ML_BACKEND_URL=http://localhost:9090
